{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HAMAL-VENTURE-STUDIO/wisdom-protocol/blob/main/contracts/wisdom-node.schema.json",
  "title": "WisdomNode v0.3 (proposed, unapproved)",
  "description": "One idea from one mentor (Legacy Leaver), with its decision rules, limits, context, provenance, consent and approval. Proposed design; not yet approved by the founder.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "address", "version", "mentor", "claim", "decision_rules", "boundaries", "provenance", "consent", "approval", "publication_status"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "description": "Opaque, permanent identifier." },
    "address": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*/[0-9]+(\\.[0-9]+){1,2}$",
      "description": "Permanent address leaver/domain.lens[.sub], e.g. major/4.10.2. Never changes once published."
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "mentor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mentor_id"],
      "properties": {
        "mentor_id": { "type": "string", "minLength": 1, "description": "Opaque ID. Real names live outside public records." },
        "display_name": { "type": ["string", "null"], "description": "Only when consent.name_likeness is granted." }
      }
    },
    "claim": { "type": "string", "minLength": 1, "description": "The idea in one sentence, in the mentor's words." },
    "decision_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule"],
        "properties": {
          "rule": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["rule", "threshold", "red_flag", "step"] }
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "firsthand"],
      "properties": {
        "summary": { "type": "string" },
        "firsthand": { "type": "boolean", "description": "True if the mentor lived it, false if secondhand." }
      }
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "When this does not apply, and who should not follow it."
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "when": { "type": "array", "items": { "type": "string" } },
        "to": { "enum": ["mentor", "licensed_professional", "human_reviewer"] }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "description": "Lets agents choose between conflicting mentors by situation instead of blending them.",
      "properties": {
        "geography": { "type": "array", "items": { "type": "string" } },
        "time_period": { "type": "string" },
        "conditions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "regulated_domain": {
      "type": "boolean",
      "default": false,
      "description": "Finance, health, law, etc. Requires legal_review.state = cleared before publication."
    },
    "legal_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["not_required", "pending", "cleared", "blocked"] },
        "record_id": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_id", "captured_at"],
      "properties": {
        "source_type": { "enum": ["interview", "founder_synthesis", "written_submission"] },
        "source_id": { "type": "string", "description": "Opaque reference to access-controlled storage. Never the transcript itself." },
        "source_location": { "type": "string", "description": "Timestamp or section in the source." },
        "captured_at": { "type": "string", "format": "date" },
        "drafted_by": { "type": "string", "description": "e.g. grace-beacon" }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "description": "Each scope is granted, declined or revoked separately.",
      "required": ["record", "extract", "publish", "license", "name_likeness"],
      "properties": {
        "record": { "$ref": "#/$defs/consentScope" },
        "extract": { "$ref": "#/$defs/consentScope" },
        "publish": { "$ref": "#/$defs/consentScope" },
        "license": { "$ref": "#/$defs/consentScope" },
        "name_likeness": { "$ref": "#/$defs/consentScope" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["draft", "review_requested", "approved", "revised", "rejected", "revoked"] },
        "approval_record_id": { "type": "string" },
        "decided_by": { "const": "mentor", "description": "Only the mentor approves their own node." },
        "decided_at": { "type": "string", "format": "date" },
        "permitted_uses": { "type": "array", "items": { "enum": ["agent_retrieval", "pathfinder_lesson", "public_demo", "commercial_license"] } },
        "expires_at": { "type": ["string", "null"], "format": "date" }
      }
    },
    "publication_status": { "enum": ["private", "approved_unpublished", "published", "unpublished"] },
    "lens": { "type": "string", "description": "One of the 10 learning lenses, e.g. knolling, schematic." },
    "visual_spec": { "type": "string" },
    "quiz": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "answer"],
        "properties": { "question": { "type": "string" }, "answer": { "type": "string" } }
      }
    },
    "conflicting_node_ids": { "type": "array", "items": { "type": "string" }, "description": "Nodes that disagree with this one. Disagreement is kept, not averaged." }
  },
  "$defs": {
    "consentScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["granted", "declined", "revoked", "not_asked"] },
        "record_id": { "type": "string" },
        "at": { "type": "string", "format": "date" }
      }
    }
  },
  "allOf": [
    {
      "description": "Approved nodes need a mentor decision with a record.",
      "if": { "properties": { "approval": { "properties": { "state": { "const": "approved" } } } } },
      "then": { "properties": { "approval": { "required": ["approval_record_id", "decided_by", "decided_at", "permitted_uses"] } } }
    },
    {
      "description": "Published nodes must be approved and have publish consent granted.",
      "if": { "properties": { "publication_status": { "const": "published" } } },
      "then": {
        "properties": {
          "approval": { "properties": { "state": { "const": "approved" } } },
          "consent": { "properties": { "publish": { "properties": { "state": { "const": "granted" } } } } }
        }
      }
    },
    {
      "description": "A display name requires name/likeness consent.",
      "if": { "properties": { "mentor": { "required": ["display_name"], "properties": { "display_name": { "type": "string" } } } } },
      "then": { "properties": { "consent": { "properties": { "name_likeness": { "properties": { "state": { "const": "granted" } } } } } } }
    },
    {
      "description": "Published regulated-domain nodes must be legally cleared.",
      "if": { "properties": { "regulated_domain": { "const": true }, "publication_status": { "const": "published" } }, "required": ["regulated_domain"] },
      "then": { "required": ["legal_review"], "properties": { "legal_review": { "properties": { "state": { "const": "cleared" } } } } }
    }
  ]
}
